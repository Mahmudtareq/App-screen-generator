# MongoDB — a local instance or an Atlas connection string
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="mockup-studio"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google sign-in (optional — the button is hidden when these are unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary — Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Website capture (optional) — without a key, Microlink's free endpoint is used,
# which is rate limited per IP at roughly 50 requests/day
MICROLINK_API_KEY=""

# Comma-separated emails allowed into the admin panel (device management).
ADMIN_EMAILS=""

# Base URL of this app, used by the server-side api-client to call its own API
# routes. Must match the deployed origin in production.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
